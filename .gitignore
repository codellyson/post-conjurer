node_modules/
dist/
*.log
.DS_Store
.env

# Rust build output — several gigabytes, fully reproducible from Cargo.lock.
src-tauri/target/

# Generated by tauri-build at compile time from tauri.conf.json and the
# capability files; regenerating is part of every build.
src-tauri/gen/

# WXT's bundled extension and its generated type shims — both rebuilt by
# `pnpm --filter @post-conjurer/extension build`.
apps/extension/.output/
apps/extension/.wxt/

# Internal notes for a designer, not part of the published project. Kept on
# disk deliberately — ignored so it can't be re-added by `git add -A`.
DESIGN-BRIEF.md

# pnpm keeps one lockfile, at the workspace root. A nested one is a leftover
# from running pnpm inside a package directory and will drift from the root.
apps/*/pnpm-lock.yaml
