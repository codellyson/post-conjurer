{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://x.com/*" },
        { "url": "https://www.linkedin.com/*" },
        { "url": "https://bsky.app/*" },
        { "url": "https://mastodon.social/*" }
      ]
    }
  ]
}
